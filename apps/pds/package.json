{
  "name": "@minisphere/pds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typegen": "wrangler types -c wrangler.jsonc -c ../directory/wrangler.jsonc",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:local": "wrangler d1 migrations apply PDS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PDS_DB --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@atcute/atproto": "catalog:",
    "@atcute/car": "catalog:",
    "@atcute/cbor": "catalog:",
    "@atcute/cid": "catalog:",
    "@atcute/crypto": "catalog:",
    "@atcute/did-plc": "catalog:",
    "@atcute/identity-resolver": "catalog:",
    "@atcute/lexicons": "catalog:",
    "@atcute/mst": "catalog:",
    "@atcute/tid": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@minisphere/hono-utils": "workspace:*",
    "@minisphere/repo-do": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
