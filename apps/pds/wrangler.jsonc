{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-pds",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8787,
    "inspector_port": 0,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "pds.hopsken.dev",
    },
  ],
  "vars": {
    "ACCOUNTS_ORIGIN": "https://accounts.hopsken.dev",
    "PDS_ORIGIN": "https://pds.hopsken.dev",
  },
  "secrets": {
    "required": ["PDS_JWT_SECRET", "PDS_SIGNING_KEY_ENCRYPTION_KEY"],
  },
  "services": [
    {
      "binding": "DIRECTORY",
      "service": "minisphere-directory",
    },
  ],
  "d1_databases": [
    {
      "binding": "PDS_DB",
      "database_name": "minisphere-pds",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "72a38bfb-f793-43ec-b07d-51299499c79f",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "RepoDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoDO"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
}
