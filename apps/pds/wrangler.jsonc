{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-pds",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "dev": {
    "port": 8787,
    "inspector_port": 0,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "minisphere-pds-blobs",
    },
  ],
  "d1_databases": [
    {
      "binding": "PDS_DB",
      "database_name": "minisphere-pds",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "72a38bfb-f793-43ec-b07d-51299499c79f",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "RepoDO",
      },
      {
        "name": "SEQUENCER",
        "class_name": "SequencerDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SequencerDO"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
}
