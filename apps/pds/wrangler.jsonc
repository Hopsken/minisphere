{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-pds",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["PDS_HOSTNAME", "PDS_JWT_SECRET", "PDS_ROTATION_KEY"],
  },
  "services": [
    {
      "binding": "DIRECTORY",
      "service": "minisphere-directory",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "PDS_KV",
      // Replace this placeholder with the ID returned by `wrangler kv namespace create` before deploying.
      "id": "00000000000000000000000000000000",
    },
  ],
  "d1_databases": [
    {
      "binding": "PDS_DB",
      "database_name": "minisphere-pds",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "RepoDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoDO"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
}
