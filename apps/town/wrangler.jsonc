{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-town",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth-client-metadata.json"],
    "directory": "./dist/client",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "town.hopsken.dev",
    },
  ],
  "vars": {
    "PDS_ORIGIN": "https://pds.hopsken.dev",
    "PUBLIC_URL": "https://town.hopsken.dev",
  },
  "services": [
    {
      "binding": "DIRECTORY",
      "service": "minisphere-directory",
    },
  ],
}
