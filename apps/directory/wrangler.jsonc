{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-directory",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "plc.hopsken.dev",
    },
  ],
  "dev": {
    "port": 8788,
    "inspector_port": 0,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minisphere-directory",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "ba5ebec8-78df-4ff6-84f0-8a28d19c0bc9",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
}
