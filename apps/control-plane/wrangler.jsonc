{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-control-plane",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "secrets": {
    "required": [
      "CONTROL_PLANE_ENCRYPTION_KEY",
      "CONTROL_PLANE_ACCOUNT_RECOVERY_KEY",
      "PDS_ORIGIN",
    ],
  },
  "services": [
    {
      "binding": "PDS",
      "service": "minisphere-pds",
      "entrypoint": "PdsControlPlane",
    },
    {
      "binding": "PlcDirectory",
      "service": "minisphere-directory",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minisphere-control-plane",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
}
