{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-control-plane",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "directory": "./dist/client",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [
    {
      "pattern": "ctrl.hopsken.dev",
      "custom_domain": true,
    },
  ],
  "vars": {
    "HANDLE_DOMAIN": "r2d2.party",
  },
  "secrets": {
    "required": [
      "CONTROL_PLANE_ENCRYPTION_KEY",
      "CONTROL_PLANE_ACCOUNT_RECOVERY_KEY",
      "PDS_ORIGIN",
    ],
  },
  "services": [
    {
      "binding": "PDS",
      "service": "minisphere-pds",
      "entrypoint": "PdsControlPlane",
    },
    {
      "binding": "PlcDirectory",
      "service": "minisphere-directory",
    },
    {
      "binding": "HandleRegistry",
      "service": "minisphere-handle-registry",
      "entrypoint": "HandleRegistryEntrypoint",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minisphere-control-plane",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "ee5cd4ab-7199-48b8-a86b-ae20f12d8f7e",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
}
