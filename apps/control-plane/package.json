{
  "name": "@minisphere/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types -c ./wrangler.jsonc -c ../pds/wrangler.jsonc -c ../directory/wrangler.jsonc",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/client": "^5.1.1",
    "@atcute/crypto": "^2.4.4",
    "@atcute/did-plc": "^1.0.1",
    "@atcute/identity-resolver": "^2.0.1",
    "@atcute/lexicons": "^2.1.0",
    "@atcute/multibase": "^1.2.5",
    "@base-ui/react": "^1.7.0",
    "@blobatar/react": "^2.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@minisphere/hono-utils": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "blobatar": "^2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.3",
    "jose": "^6.2.9",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
