{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-accounts",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "directory": "./dist/client",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "accounts.hopsken.dev",
    },
  ],
  "vars": {
    "PUBLIC_URL": "accounts.hopsken.dev",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minisphere-accounts",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "0af6d2b9-6931-4dd7-ad33-85af37ee0924",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
}
