{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-accounts",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/.well-known/oauth-authorization-server",
      "/api/*",
      "/health",
      "/oauth/*",
      "/__dev/*",
    ],
    "directory": "./dist/client",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "accounts.hopsken.dev",
    },
  ],
  "vars": {
    "OIDC_PROVIDER_NAME": "Identity provider",
    "PUBLIC_URL": "https://accounts.hopsken.dev",
    "PUBLIC_HANDLE_DOMAIN": "r2d2.party",
  },
  "services": [
    {
      "binding": "DIRECTORY",
      "service": "minisphere-directory",
    },
    {
      "binding": "PDS",
      "service": "minisphere-pds",
      "entrypoint": "PdsControlPlane",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minisphere-accounts",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "0af6d2b9-6931-4dd7-ad33-85af37ee0924",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
}
