{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["./worker-configuration.d.ts", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "worker/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
