{
  "name": "@minisphere/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typegen": "wrangler types -c ./wrangler.jsonc -c ../pds/wrangler.jsonc -c ../directory/wrangler.jsonc",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "auth:generate": "pnpm dlx auth@latest generate --config better-auth.config.ts --output ./worker/db/schema/better-auth.ts",
    "auth:create:admin": "pnpm dlx auth@latest create-admin --email admin@example.com --name 'Admin' --role admin --config better-auth.config.ts",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "postinstall": "pnpm typegen"
  },
  "dependencies": {
    "@atcute/atproto": "catalog:",
    "@atcute/client": "catalog:",
    "@atcute/did-plc": "catalog:",
    "@base-ui/react": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@minisphere/hono-utils": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
