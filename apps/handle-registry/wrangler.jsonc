{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-handle-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "dev": {
    "port": 8789,
    "inspector_port": 0,
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "*.r2d2.party/*",
      "zone_name": "r2d2.party",
    },
  ],
  "vars": {
    "DOMAIN": "r2d2.party",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minisphere-handle-registry",
      // Replace this placeholder with the ID returned by `wrangler d1 create` before deploying.
      "database_id": "01e88087-1cbc-4457-8e66-2c52ecfb07ab",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
}
