{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minisphere-handle-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "dev": {
    "port": 8789,
    "inspector_port": 0,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "*.r2d2.party/*",
      "zone_name": "r2d2.party",
    },
  ],
  "services": [
    {
      "binding": "Accounts",
      "service": "minisphere-accounts",
      "entrypoint": "AccountsEntrypoint",
    },
  ],
}
