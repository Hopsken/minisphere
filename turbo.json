{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typegen": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "db:migrate:local": {
      "cache": false
    },
    "db:migrate:remote": {
      "cache": false
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build", "db:migrate:remote"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#dev:atproto:stack": {
      "cache": false,
      "with": [
        "@minisphere/directory#dev",
        "@minisphere/pds#dev",
        "@minisphere/accounts#dev",
        "@minisphere/handle-registry#dev"
      ]
    },
    "//#dev:town:local:stack": {
      "cache": false,
      "with": [
        "@minisphere/town#dev",
        "@minisphere/directory#dev",
        "@minisphere/pds#dev",
        "@minisphere/accounts#dev",
        "@minisphere/handle-registry#dev"
      ]
    },
    "//#format:check:root": {},
    "//#lint:root": {},
    "test": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["typegen", "^typecheck"],
      "outputs": []
    }
  }
}
