{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typegen": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "db:migrate:local": {
      "interactive": true,
      "cache": false
    },
    "db:migrate:remote": {
      "cache": false
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build", "db:migrate:remote"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "//#format:check:root": {},
    "//#lint:root": {},
    "test": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["typegen", "^typecheck"],
      "outputs": []
    }
  }
}
