{
  "name": "minisphere",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "turbo run typecheck test build lint:root format:check:root",
    "deploy": "turbo deploy",
    "dev:accounts": "turbo dev --filter=@minisphere/accounts",
    "dev:control": "turbo dev --filter=@minisphere/control-plane",
    "dev:directory": "turbo dev --filter=@minisphere/directory",
    "dev:handle-registry": "turbo dev --filter=@minisphere/handle-registry",
    "dev:pds": "turbo dev --filter=@minisphere/pds",
    "dev:town": "turbo dev --filter=@minisphere/town",
    "format": "oxfmt --write .",
    "format:check": "turbo format:check:root",
    "format:check:root": "oxfmt --check .",
    "lint": "turbo lint:root",
    "lint:fix": "oxlint --fix .",
    "lint:root": "oxlint .",
    "setup:local": "turbo run typegen db:migrate:local",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
