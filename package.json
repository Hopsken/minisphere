{
  "name": "alto-network",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "deploy": "turbo deploy",
    "dev": "turbo dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.4",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@11.21.0"
}
