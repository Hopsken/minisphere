{
  "name": "loma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run typecheck && pnpm test && ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "es-toolkit": "^1.50.0",
    "tiny-invariant": "^1.3.3",
    "typebox": "^1.3.13"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
